+@pytest.mark.parametrize("family", ("Hermite", "HER"))
+@pytest.mark.parametrize("degree", (3, 4, 5, 7))
+def test_interval_hermite_degree(family: str, degree: int) -> None:
+    element = finat.ufl.FiniteElement(family, ufl.interval, degree)
+    cubic = finat.ufl.FiniteElement(family, ufl.interval, 3)
+    assert cubic.reconstruct(degree=degree) == element
+    assert element.degree() == degree
+
+
+@pytest.mark.parametrize("family", ("Hermite", "HER"))
+@pytest.mark.parametrize("cell_name, degree", (
+    ("interval", 2),
+    ("triangle", 4),
+    ("triangle", 5),
+    ("tetrahedron", 4),
+    ("tetrahedron", 5),
+))
+def test_hermite_invalid_degree(family: str, cell_name: str, degree: int) -> None:
+    cell = ufl.Cell(cell_name)
+    cubic = finat.ufl.FiniteElement(family, cell, 3)
+    with pytest.raises(ValueError, match="Order .* invalid for 'Hermite'"):
+        finat.ufl.FiniteElement(family, cell, degree)
+    with pytest.raises(ValueError, match="Order .* invalid for 'Hermite'"):
+        cubic.reconstruct(degree=degree)
